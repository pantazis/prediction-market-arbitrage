  {
    "id": "0x4bcc87902241ab0ffcbe9eeb3668c51bcdb218e157b1f8390a639272c54d2def",
    "question": "Will the winner of Beast Games: Season 2 be Strong or Smart?",
    "outcomes": [
      {
        "id": "71977483082346097854937668351373096387385700909775366574237549810398859416935",
        "label": "Strong",
        "price": 0.855,
