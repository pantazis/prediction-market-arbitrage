  {
    "id": "0x4167e22670f31e5f93d132f78108f3fae809bd15cadf78983eff096845ed1415",
    "question": "Ukraine signs peace deal with Russia before 2027?",
    "outcomes": [
      {
        "id": "93579588306754356558129639371052358607099327699211232141859164590129536814208",
        "label": "Yes",
        "price": 0.39,
