  {
    "id": "0x50e54348ebdc5218e17ab7cec6c6d1bda4816f979984717cf462d816921255d6",
    "question": "Will the Centrist Reform Alliance win the second-most seats in the 2026 Japanese general election?",
    "outcomes": [
      {
        "id": "82547212645026470525278120787743350118721505496069116064469109192086879778892",
        "label": "Yes",
        "price": 0.93,
        "liquidity": 2605.1143,
        "last_updated": null
      },
      {
        "id": "68807170344581978269785042777291531812907438296702298129119130028792894246621",
        "label": "No",
