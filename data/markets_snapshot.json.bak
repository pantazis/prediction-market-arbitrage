    "threshold": null,
    "asset": "sex",
    "expiry": "2027-12-31T00:00:00Z"
  },
  {
    "id": "0x0edd688013e4d08dd5367b9171bf85c6df73f2a4f561ed3c8ce004271c8278b7",
