  {
    "id": "0x5d3bcedaaa67743f4ac083a67ef8cc33cb22b24444e477baecfce44e6c3a6b20",
    "question": "Will India join the Board of Peace?",
    "outcomes": [
      {
        "id": "68680406354166188404103756062811476877196934004335782810240366242900330553695",
        "label": "Yes",
        "price": 0.49,
