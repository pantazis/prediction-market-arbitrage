    "expiry": "2026-02-28T00:00:00Z"
  },
  {
    "id": "0x33a3e96a12a5d7f46aabec104a70b0f5315ff72fd63cdeeb6371af7caed53130",
    "question": "Will APT (Ros\u00e9 and Bruno Mars) win Record of the Year at the 68th Annual GRAMMY Awards?",
    "outcomes": [
      {
        "id": "23970205044064633626785571238629336599825678664173004210005320305887520153957",
        "label": "Yes",
        "price": 0.17,
        "liquidity": 4699.5321,
        "last_updated": null
