  {
    "id": "0x9e47ca95afefba838dd468e94c6b5e83bfd666fb7296294409bdb486188257b2",
    "question": "Will Reform Party (RP) win the 2026 South Korean local elections?",
    "outcomes": [
      {
        "id": "20757482683315520642463662336039250731004243557924532060863767741034439780989",
        "label": "Yes",
        "price": 0.0025,
