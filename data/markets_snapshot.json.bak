  {
    "id": "0xd4d00e5bf8b960cc37c74c1ec19e41e00b0706add203ddcfbb65ad006c5c223a",
    "question": "Will the Fed increase interest rates by 25+ bps after the April 2026 meeting?",
    "outcomes": [
      {
        "id": "9556122149160720922715284597610520228366807023831966638741974320131898296289",
        "label": "Yes",
        "price": 0.0145,
