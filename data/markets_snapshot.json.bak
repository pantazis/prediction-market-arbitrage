  {
    "id": "0x56c45af8a9da0502092edaa3ca192d0798fa02460c838f09764c90d4635b6577",
    "question": "Will the next Dutch government be GL/PvdA + VVD + D66?",
    "outcomes": [
      {
        "id": "86416838264878156440731264736325710356998731851760664379405701004716325741008",
        "label": "Yes",
        "price": 0.006,
        "liquidity": 7069.64048,
