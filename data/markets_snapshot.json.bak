  {
    "id": "0xdd9b291d3cb5674a07c1b763a53052295bb5a2fae8b62f208282933981f1dd80",
    "question": "Will the Japanese Communist Party win the most seats in the 2026 Japanese general election?",
    "outcomes": [
      {
        "id": "76483530075340960653823517374414199699175050718813632168668273365754742455610",
        "label": "Yes",
        "price": 0.0015,
