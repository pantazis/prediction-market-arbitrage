  {
    "id": "0x8da0a23017da253d7fafe553c8e2f4461345862505fb8d8639e26fd6cffa8137",
    "question": "Will Jatiya Samajtantrik Dal win the most seats in the Bangladesh parliamentary election?",
    "outcomes": [
      {
        "id": "94077200590834580121684903888828493849419274188464233370308447228776486415631",
        "label": "Yes",
        "price": 0.0015,
