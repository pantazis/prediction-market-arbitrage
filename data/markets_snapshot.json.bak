  {
    "id": "0x2805ea0ae23b0b69154aa3837037ff55f8009726759509f1f7cd759ebd6d929d",
    "question": "Will Jamieson Greer be the first to leave the Trump Cabinet before 2027?",
    "outcomes": [
      {
        "id": "106779597491606998790583191947218632675983309161673070562336069648790442472258",
        "label": "Yes",
        "price": 0.0115,
