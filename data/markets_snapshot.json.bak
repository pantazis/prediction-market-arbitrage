  {
    "id": "0xa8385abd97afc1601c28548fc257be5a732f54c26b046238929f92c4190980ad",
    "question": "Will Russia strike on Kyiv municipality on January 30?",
    "outcomes": [
      {
        "id": "107821154128596556357463265698095821194964001696633981257128563101748956807954",
        "label": "Yes",
        "price": 0.34,
