  {
    "id": "0xd3320fd4b325ce3d629fbaffd90bebd0a4f45042d91bf207c9866704d630bdb9",
    "question": "NATO x Russia military clash by March 31, 2026?",
    "outcomes": [
      {
        "id": "16796294837862213749214191185380591986043723823732945104815587989221348740344",
        "label": "Yes",
        "price": 0.044,
