  {
    "id": "0xa47c3241c8f51d4f02d8c6dea507d8ceee4be1adc425cecc933564c762ee24ad",
    "question": "Israel x Syria security agreement by January 31?",
    "outcomes": [
      {
        "id": "36685313325836492969220221488073883383556836789057849866984039832816676096694",
        "label": "Yes",
        "price": 0.041,
        "liquidity": 2795.959325,
        "last_updated": null
