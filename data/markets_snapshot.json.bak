  {
    "id": "0xb538c58c7b72f0fa9d16bdb919ff541aee036c9bf72426fea383c451afa131e8",
    "question": "Will Russia capture all of Myrnohrad by January 31?",
    "outcomes": [
      {
        "id": "43809820048030713320819642807596010667146583950047817610925533064689255089330",
        "label": "Yes",
        "price": 0.075,
        "liquidity": 6828.53825,
