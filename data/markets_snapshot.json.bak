  {
    "id": "0x29e22f55c09b2b33273291eb42f354ae5e1c78dd9edd4940f1bda1b7dcf8c7b8",
    "question": "Will Doug Burgum be the first to leave the Trump Cabinet before 2027?",
    "outcomes": [
      {
        "id": "69591735669129880815195212796288377237330842451437111701441209820488311444218",
        "label": "Yes",
        "price": 0.0065,
        "liquidity": 2777.944575,
        "last_updated": null
