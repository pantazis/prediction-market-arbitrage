  {
    "id": "0xc7ce6c0c8f5fbcc12587f264cbf8795a8a254df10bf50ebbaae05a9179ba5959",
    "question": "Will Israel strike Gaza on January 24, 2026?",
    "outcomes": [
      {
        "id": "66217922823202706660918177763595218089782822880312916890620402270756611869922",
        "label": "Yes",
        "price": 0.285,
