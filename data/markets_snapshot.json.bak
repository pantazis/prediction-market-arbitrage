  {
    "id": "0x6a12068003a55b0b1ac616484a30a073121ea81f82182ecfd6529821d1ff2174",
    "question": "Will Silver hit 100 or Bitcoin hit 100k first?",
    "outcomes": [
      {
        "id": "72575627175328731363135953575984308266842231919931142482180123128151629312663",
        "label": "Silver",
        "price": 0.953,
