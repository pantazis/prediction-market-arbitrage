  {
    "id": "0x257b18205f908aef01ef2d1d50e6fea7d29cf5486fe04031d8b101394476faed",
    "question": "Will there be no change in Fed interest rates after the March 2026 meeting?",
    "outcomes": [
      {
        "id": "102559817034631022221500208641784929295731053857601013029449249654006364919935",
        "label": "Yes",
        "price": 0.815,
