  {
    "id": "0x6f81c07451afe887d08587d27952d1cbdffef03674baa0c3eba45748db149c4c",
    "question": "S&P 500 (SPX) Opens Up or Down on January 23?",
    "outcomes": [
      {
        "id": "75264862169644309181571161190963242524463596528749720401254204737042129102832",
        "label": "Up",
        "price": 0.475,
