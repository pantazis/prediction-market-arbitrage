  {
    "id": "0xa2e277d0b00fb45b47fbac66c8418dcc2ccfbc1e9fe3152357695f329e532a74",
    "question": "Will the Netherlands join the Board of Peace?",
    "outcomes": [
      {
        "id": "75688407611155443610013598102472676416863093180463895162966761380246937579713",
        "label": "Yes",
        "price": 0.145,
        "liquidity": 929.3536,
        "last_updated": null
      },
      {
        "id": "113600754094371822036456922290399688984413993380640205154181661203051691740898",
        "label": "No",
        "price": 0.855,
