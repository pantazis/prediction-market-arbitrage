  {
    "id": "0xfad080aab1cc1549d2dcefc782461969e89a63329a643506ee85ae9682140dca",
    "question": "Will SpaceX's public ticker be $MARS?",
    "outcomes": [
      {
        "id": "65727333669531232905091448824819612789481034857852260350036556651884360807432",
        "label": "Yes",
        "price": 0.102,
