    "id": "0x04da396ad00ff8cd36bf858a3b8d82812432bd7adc20d3c4748849079c52e264",
    "question": "Will Lee Zeldin be the first to leave the Trump Cabinet before 2027?",
    "outcomes": [
      {
        "id": "48975690903678628526383086569088560354912989355071694527478748382142125266438",
        "label": "Yes",
        "price": 0.0125,
