  {
    "id": "0xe564d03f9094d24cc874e8e7fc398eabc5a87008dfc168185a9aeacb2a389d76",
    "question": "Will the Centrist Reform Alliance win the third-most seats in the 2026 Japanese general election?",
    "outcomes": [
      {
        "id": "46998547107412559495916329942009836519578266584680162296094060575503607691663",
        "label": "Yes",
        "price": 0.0475,
