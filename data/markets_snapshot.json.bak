  {
    "id": "0xbb6e02d1b77e26964331305ca9f12da8c6f676e1efe893372485425becbed223",
    "question": "Will Russia capture all of Pokrovsk by January 31?",
    "outcomes": [
      {
        "id": "84564904382008311962069365288283225167949742624603481609433520601697502508513",
        "label": "Yes",
        "price": 0.038,
