  {
    "id": "0x4efa52760df49a5626b3ab7bf2a158e1ef30cbbf5454f4fcf4415d448509be70",
    "question": "Will the Eurozone's 2026 Annual Inflation be less than 1.0%?",
    "outcomes": [
      {
        "id": "36547151791471767792557978047668306497682264127635715132063193991549138933742",
        "label": "Yes",
        "price": 0.08,
