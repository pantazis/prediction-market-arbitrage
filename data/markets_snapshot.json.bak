    "id": "0xafb23268a1782cd0eb4c5d43e400f78a39030c7cf708c060a258f2334b3f9d77",
    "question": "Will Ford Motor (F) beat quarterly earnings?",
    "outcomes": [
      {
        "id": "74551600767062947222291891614408884465454226500838360341456146362778851766173",
        "label": "Yes",
        "price": 0.75,
