    "id": "0xc71ae60417a812b0a16d7eca04bbd5db4a330a56b3c8cb4fe254f2a7b77207f3",
    "question": "Will Russia capture Bilytske by March 31, 2026?",
    "outcomes": [
      {
        "id": "100441399760622064650840625494872216181329090159239475460428335733835379523137",
        "label": "Yes",
