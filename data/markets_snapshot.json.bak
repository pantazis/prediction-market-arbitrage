  {
    "id": "0xdde06286a7b9464d344f410ab0b3d2ebc6469904e72c27fd982f65fdbf78768d",
    "question": "Will the Fed decrease interest rates by 25 bps after the June 2026 meeting?",
    "outcomes": [
      {
        "id": "65193234666628291664907888364936366210889305490897648116746073820519263548476",
        "label": "Yes",
        "price": 0.495,
