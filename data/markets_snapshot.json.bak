  {
    "id": "0x61510e927dea582ab39b14b2d01455e9aebd7bf5fcfc5101db4df230665feea5",
    "question": "Will Israel strike Lebanon on January 25, 2026?",
    "outcomes": [
      {
        "id": "63852174273002708398473472091651261822438393845227615128783392766214336224319",
        "label": "Yes",
        "price": 0.405,
        "liquidity": 1542.41905,
        "last_updated": null
      },
      {
        "id": "55464629107430606897323808240892556481765188247174039576919077331990235054407",
        "label": "No",
