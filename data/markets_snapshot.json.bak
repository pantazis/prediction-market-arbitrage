  {
    "id": "0x8754f590235cd66e31a4e26a7bd55176feaaccbb9f077047da851b6eeaa1da72",
    "question": "Will Team Mirai win the most seats in the 2026 Japanese general election?",
    "outcomes": [
      {
        "id": "63949678564004881369447438111149217265302130320599577058322654959815063841237",
        "label": "Yes",
        "price": 0.0015,
