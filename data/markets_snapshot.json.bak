    "id": "0xfd143c97bbb5a6c7944c83dd26aaee0ea06b7075f8fe1a425bd00347cb8061c9",
    "question": "Nikkei 225 (NIK) Up or Down on January 23?",
    "outcomes": [
      {
        "id": "113625250625463194273918208646440156271575790232524804358065443079547242710403",
        "label": "Up",
        "price": 0.9995,
        "liquidity": 6592.310885,
        "last_updated": null
      },
      {
        "id": "106281825807316227175586653995717195392788807668239476157496816214698342083358",
        "label": "Down",
        "price": 0.0005,
        "liquidity": 6592.310885,
        "last_updated": null
      }
    ],
    "end_date": "2026-01-23T21:00:00Z",
    "liquidity": 13184.62177,
    "volume": 56033.248802,
    "tags": [],
    "resolution_source": "https://www.wsj.com/market-data/stocks/asia",
    "description": "This market will resolve to \"Up\" if the official Nikkei 225 Index closing price for Nikkei 225 (NIK) on Friday, January 23, 2026 is higher than the official Nikkei 225 Index closing price for NIK on the most recent prior trading day.\n\nThis market will resolve to \"Down\" if the official Nikkei 225 Index closing price for Nikkei 225 (NIK) on Friday, January 23, 2026 is lower than the official Nikkei 225 Index closing price for NIK on the most recent prior trading day.\n\nE.g., ordinarily, a market on Monday would refer to the previous Friday for its most recent closing price, unless that Friday were a market holiday, in which case it would refer to Thursday, or the next most recent trading day.\n\nIf the two specified closing prices are exactly equal, this market will resolve 50-50. Note that all figures will be rounded to the nearest cent using standard rounding.\n\nIf NIK does not trade at all during the regular session, the market will resolve 50-50.\n\nIf either of the relevant days are shortened (for example, due to a market holiday schedule), the official closing price published by Nikkei 225 Index for that shortened session will still be used for resolution.\n\nIf either of the relevant days have no official closing price (for example, due to a trading halt into the market close, system issue, delisting, or other disruption), the market will use the last valid on-exchange trade price of the regular session as the effective closing price.\n\nThe resolution source for this market is the Wall Street Journal, specifically the Close values published by the WSJ under \"Historical Prices\".\n\nUS: https://www.wsj.com/market-data/stocks\nEMEA: https://www.wsj.com/market-data/stocks/emea \nASIA: https://www.wsj.com/market-data/stocks/asia",
    "best_bid": {},
    "best_ask": {},
    "series_id": null,
    "category": null,
    "slug": null,
    "trades_1h": null,
    "updated_at": "2026-01-23T12:18:38.405017Z",
    "exchange": "polymarket",
    "comparator": null,
    "threshold": null,
    "asset": "nik",
    "expiry": "2026-01-23T21:00:00Z"
  },
