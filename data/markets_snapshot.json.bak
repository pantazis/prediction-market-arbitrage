  {
    "id": "0x4b23c2e3ee806915cc1186641d292acbc6b26d7a7746ee93c910b8b0c87d4bca",
    "question": "Will the Fed Cut\u2013Pause\u2013Pause in the next three decisions (Dec\u2013Jan\u2013Mar)?",
    "outcomes": [
      {
        "id": "76079112027472838335290455592014338879214017693395013229937591392536082897129",
        "label": "Yes",
        "price": 0.8,
