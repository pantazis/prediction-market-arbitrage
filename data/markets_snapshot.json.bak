    "id": "0xb8a9a44a11b90fa26e85980d0450e6738796d71ea11bdd637d920fbdf36c9ac8",
    "question": "Will Trump\u2019s Greenland Tariffs go into effect for The Netherlands by Feburary 1?",
    "outcomes": [
      {
        "id": "70648101080090968373073364066521565369615174345142730341592550123854585734391",
        "label": "Yes",
        "price": 0.015,
