  {
    "id": "0xa466e17524bcc473279c4ca86f4f1fb01932946a8204e68f6ca96628f8bf2b5e",
    "question": "China x Japan military clash before 2027?",
    "outcomes": [
      {
        "id": "24359841971256354562338291910316825498086150942929460621080163666720754945761",
        "label": "Yes",
