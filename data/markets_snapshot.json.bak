  {
    "id": "0xfeea8dda9f7313888dbefbb5f98cffa4f5da02a6096713a29ec8aaaf21b89de2",
    "question": "Will the Social Democratic Party win the most seats in the 2026 Japanese general election?",
    "outcomes": [
      {
        "id": "64980082275856316851444378336650865521885002952493240746158693600782815805857",
        "label": "Yes",
        "price": 0.0015,
