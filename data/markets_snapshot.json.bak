    "id": "0xe94ab06ef95d214fe80954253648430e35b1916578e88f61e09f27fc697992be",
    "question": "Will Russia capture Hryshyne by February 28, 2026?",
    "outcomes": [
      {
        "id": "50542064621184561349707331015145156913358801313849201002479571845882477088291",
        "label": "Yes",
        "price": 0.21,
