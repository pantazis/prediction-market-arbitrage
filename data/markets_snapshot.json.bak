    "question": "Will Palestine join the Board of Peace?",
    "outcomes": [
      {
        "id": "7617639909098818591985989162423290614702343557426051209120986596673895292995",
        "label": "Yes",
        "price": 0.115,
        "liquidity": 1278.1792,
        "last_updated": null
      },
      {
        "id": "95793402006220597091223292311367561693859860288164137861406319369314481230024",
        "label": "No",
        "price": 0.885,
        "liquidity": 1278.1792,
        "last_updated": null
