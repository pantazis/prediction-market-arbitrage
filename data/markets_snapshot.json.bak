  {
    "id": "0xc7d61e45df64370ebb33162a9c598dd70c44fcd5fb4be73a3f98eb758d909e1d",
    "question": "Will Pfizer Inc (PFE) beat quarterly earnings?",
    "outcomes": [
      {
        "id": "68693372619737002232524525462807994592224479501166652387709610834496333831288",
        "label": "Yes",
        "price": 0.83,
        "liquidity": 618.981,
