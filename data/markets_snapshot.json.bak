  {
    "id": "0x01dbcbf01823f946ab2d1c587fa987e377909369d4263df5ca82f7b993d31d7f",
    "question": "Will Israel strike Gaza on January 26, 2026?",
    "outcomes": [
      {
        "id": "115742820140875652344688918816569525648786220209086068167754043889941776435897",
        "label": "Yes",
        "price": 0.405,
