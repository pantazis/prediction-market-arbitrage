    "id": "0x6dbe4917fb2d38710e31e274d1059a9993e5d22bbddec317d32cb27a82998220",
    "question": "Will the U.K. join the Board of Peace?",
    "outcomes": [
      {
        "id": "36304453484852515401646230056533108758928416758642624412850959724657191425751",
        "label": "Yes",
        "price": 0.21,
        "liquidity": 2237.32315,
        "last_updated": null
      },
      {
        "id": "29434309624118989180461798421643674906670805927223252618934478793377730970952",
        "label": "No",
        "price": 0.79,
        "liquidity": 2237.32315,
        "last_updated": null
