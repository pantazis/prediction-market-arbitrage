    "id": "0xf335cc3103bdc40edc68be074c7a9debc9d9c47845024f728cb76875b29e0a26",
    "question": "Will Israel strike Lebanon on January 23, 2026?",
    "outcomes": [
      {
        "id": "79818575899888415125095243166665428811509383409304756434651920547314993701547",
        "label": "Yes",
        "price": 0.565,
