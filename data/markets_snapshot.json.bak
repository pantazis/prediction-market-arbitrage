  {
    "id": "0xcec504bc3695f25d82941152d2157849ee1df93464e13eff88ca039d4da2283f",
    "question": "Will the US strike Nigeria next?",
    "outcomes": [
      {
        "id": "83486213841886545335018244389964703273787642656202179522163519906888876727743",
        "label": "Yes",
        "price": 0.005,
