  {
    "id": "0x36e8ca24d2a13435f519f15580d42b45cdbe3bc425fb39a7c2733260357af0fa",
    "question": "Will there be no change in Fed interest rates after the April 2026 meeting?",
    "outcomes": [
      {
        "id": "63586620628756015058616403521099137018911742768824051367331188904593189743777",
        "label": "Yes",
        "price": 0.71,
