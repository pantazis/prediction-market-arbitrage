  {
    "id": "0xeaba77cfb29dd6b54f01ed38f506a73f4dec061421053342a095663811276d45",
    "question": "Will Brooke Rollins be the first to leave the Trump Cabinet before 2027?",
    "outcomes": [
      {
        "id": "54741891448639272244399852438840722688020401059251677816796946684814110090453",
        "label": "Yes",
        "price": 0.015,
