    "id": "0x21bf9a7dae81b6bd51acae73185686ab8997b81b1401e4be10e114d472599c26",
    "question": "Will Ukraine agree to cede territory to Russia before 2027?",
    "outcomes": [
      {
        "id": "60550692412996164477361673304744222976539035905940935096587343919192326604823",
        "label": "Yes",
        "price": 0.265,
        "liquidity": 20298.10235,
