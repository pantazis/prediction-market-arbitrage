    "id": "0x74a960f6e74324d124183f786467b089beebaaa34b075181c55e823b18bde048",
    "question": "Will Russia capture all of Donetsk Oblast by March 31, 2026?",
    "outcomes": [
      {
        "id": "78793947695488461906291194696651727856206095791749037634142632859804304098517",
        "label": "Yes",
        "price": 0.003,
