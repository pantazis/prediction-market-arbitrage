  {
    "id": "0xdeb615a52cd114e5aa27d8344ae506a72bea81f6ed13f5915f050b615a193c20",
    "question": "Will the Fed decrease interest rates by 50+ bps after the March 2026 meeting?",
    "outcomes": [
      {
        "id": "46553455570564517989191023458705371521436514261892866503067981558938998232024",
        "label": "Yes",
