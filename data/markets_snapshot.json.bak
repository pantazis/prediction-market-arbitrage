    "question": "Will the Liberal Democratic Party of Russia (LDPR) gain the most seats in the next Russian parliamentary election?",
    "outcomes": [
      {
        "id": "15542559311360205718528742674119037507303557005670729042870301990328002599887",
        "label": "Yes",
        "price": 0.0465,
