  {
    "id": "0xb2b5ba1688887a69d18aebeee1385dd996aa1e71514acebf163b986fc0f820f0",
    "question": "Will American Airlines (AAL) beat quarterly earnings?",
    "outcomes": [
      {
        "id": "7277235547110322422178426644813853276766363674873297943557042551872406268335",
        "label": "Yes",
        "price": 0.7325,
        "liquidity": 711.098505,
