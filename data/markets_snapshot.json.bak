    "id": "0x44a2ca609a1685b37999c76386eb468a124b8e5cf6ff082bef83f02e7cf61f20",
    "question": "Will Israel strike Greater Beirut by January 31, 2026?",
    "outcomes": [
      {
        "id": "45920570956826604332636964966727522802610469915302592935520460225278959421145",
        "label": "Yes",
        "price": 0.11,
        "liquidity": 1241.2187,
        "last_updated": null
      },
      {
        "id": "40110981121556506306305351667829573503393590478453265009703461211206037457778",
        "label": "No",
