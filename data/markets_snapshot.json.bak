    "id": "0x400ddb4652a3aef5f03c8aa42a530a940caaf5b6fa5b8428a345db34511c8d7d",
    "question": "Will Israel strike Lebanon on January 22, 2026?",
    "outcomes": [
      {
        "id": "16994272293118619784607530285535194632777830290060974342474746555549272858582",
        "label": "Yes",
        "price": 0.005,
