  {
    "id": "0x857a2ae8088bc256184d6684adfdc7832d072e526c1e8f0d218c1160770c20e9",
    "question": "Will the upper bound of the target federal funds rate be \u22641.0% at the end of 2026?",
    "outcomes": [
      {
        "id": "8428905054197455020031495106070658435380642200638989046327033285092773824082",
        "label": "Yes",
        "price": 0.025,
        "liquidity": 9155.106545,
        "last_updated": null
