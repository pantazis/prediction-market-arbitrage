        "label": "No",
        "price": 0.1355,
        "liquidity": 1402.58486,
        "last_updated": null
      }
    ],
    "end_date": "2026-01-31T00:00:00Z",
    "liquidity": 2805.16972,
    "volume": 42897.41185,
    "tags": [],
    "resolution_source": "",
    "description": "The Doomsday Clock is a symbolic clock face that represents the likelihood of a man-made global catastrophe, maintained since 1947 by the members of the Bulletin of the Atomic Scientists. The closer the clock is set to midnight, the closer the scientists believe the world is to global disaster.\n\nThis market will resolve to \"Yes\" if the Doomsday Clock is set closer to midnight (i.e. closer than 89 seconds to midnight, see https://thebulletin.org/doomsday-clock/#nav_menu) during the yearly meeting of the Bulletin of the Atomic Scientists scheduled for January 2026 ET. Otherwise, this market will resolve to \"No\".\n\nIf the Doomsday Clock setting is delayed this market's resolution may be delayed until the Bulletin of the Atomic Scientists' 2026 release is published. If no release is published by June 30, 2026 ET, this market will resolve to \"No\".\n\nThe resolution source for this market will be information released by the Bulletin of the Atomic Scientists.",
    "best_bid": {
      "yes": 0.8635,
      "no": 0.1345
    },
    "best_ask": {
      "yes": 0.8655,
      "no": 0.1365
    },
    "series_id": null,
    "category": null,
    "slug": null,
    "trades_1h": null,
    "updated_at": "2026-01-23T12:18:56.783864Z",
    "exchange": "polymarket",
    "comparator": null,
