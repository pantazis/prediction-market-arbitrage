{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "matched_pairs_pass.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["kalshi", "polymarket"],
    "properties": {
      "polarity": { "type": "string", "enum": ["normal", "inverted"] },
      "kalshi": {
        "type": "object",
        "required": ["ticker"],
        "properties": {
          "ticker": { "type": "string" },
          "expiration_time": { "type": "string" }
        },
        "additionalProperties": true
      },
      "polymarket": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "endDate": { "type": "string" },
          "tokens": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  }
}
